# Android build outputs
out/
.cache/
ccache/

# Large firmware and recovery artifacts
*.img
*.zip
*.bin
*.iso
# Fogos touchscreen firmware is required recovery input data, not a build artifact.
!device/motorola/fogos/recovery/root/vendor/firmware/*.bin

# Device-private or locally collected files
private-inputs/
local/
*.log

# Editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
